{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@clypra-studio/shaders": ["../shaders/src/index.ts"],
      "@clypra-studio/shaders/*": ["../shaders/src/*"],
      "@clypra-studio/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src/index.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/effects/**",
    "src/media/mediaSpriteFactory.ts",
    "src/overlays/overlayBridge.ts",
    "src/smartOverlays/annotationVisualization.ts",
    "src/smartOverlays/gaugeVisualization.ts",
    "src/smartOverlays/timelineVisualization.ts",
    "src/smartOverlays/visualizationProjection.ts",
    "src/smartOverlays/export/renderEngine.ts",
    "src/stickers/**",
    "src/text/textBridge.ts",
    "src/types/TransitionDefinition.ts",
    "src/v2/backends/**",
    "src/videoEffects/EffectDefinition.ts",
    "src/videoEffects/example.ts",
    "dist",
    "node_modules"
  ]
}
