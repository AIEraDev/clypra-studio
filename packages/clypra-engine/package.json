{
  "name": "@clypra/engine",
  "version": "2.3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transitions": {
      "types": "./dist/transitions/index.d.ts",
      "import": "./dist/transitions/index.js",
      "require": "./dist/transitions/index.cjs"
    },
    "./videoEffects": {
      "types": "./dist/videoEffects/index.d.ts",
      "import": "./dist/videoEffects/index.js",
      "require": "./dist/videoEffects/index.cjs"
    },
    "./textEffects": {
      "types": "./dist/textEffects/index.d.ts",
      "import": "./dist/textEffects/index.js",
      "require": "./dist/textEffects/index.cjs"
    },
    "./effects/video": "./dist/index.js",
    "./effects/transitions": "./dist/index.js",
    "./effects/body": "./dist/index.js",
    "./backends": {
      "types": "./dist/v2/backends/index.d.ts",
      "import": "./dist/v2/backends/index.js",
      "require": "./dist/v2/backends/index.cjs"
    },
    "./contract": {
      "types": "./dist/v2/contract/index.d.ts",
      "import": "./dist/v2/contract/index.js",
      "require": "./dist/v2/contract/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AIEraDev/clypra-studio.git",
    "directory": "packages/clypra-engine"
  },
  "homepage": "https://github.com/AIEraDev/clypra-studio/tree/main/packages/clypra-engine#readme",
  "bugs": {
    "url": "https://github.com/AIEraDev/clypra-studio/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lottie-web": "^5.13.0",
    "pixi-filters": "^6.0.0",
    "pixi.js": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.70",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "semantic-release": "^23.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
