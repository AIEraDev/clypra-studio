{
  "name": "@clypra-studio/types",
  "version": "0.3.0",
  "license": "MIT",
  "keywords": [
    "clypra",
    "clypra-studio",
    "typescript",
    "types",
    "video-editor",
    "open-source"
  ],
  "description": "Shared type definitions for all Clypra Studio packages - Single source of truth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js"
    },
    "./job": {
      "types": "./dist/job.d.ts",
      "import": "./dist/job.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    },
    "./vefx": {
      "types": "./dist/vefx.d.ts",
      "import": "./dist/vefx.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "tsup": "^8.3.5",
    "typescript": "~5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIEraDev/clypra-studio.git",
    "directory": "packages/types"
  },
  "homepage": "https://github.com/AIEraDev/clypra-studio/tree/main/packages/types#readme",
  "bugs": {
    "url": "https://github.com/AIEraDev/clypra-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
