{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClypraPluginManifest",
  "type": "object",
  "required": ["id", "version", "name", "category", "parameters", "engine"],
  "properties": {
    "id": { "type": "string", "example": "com.studio.cinematic-glow" },
    "name": { "type": "string", "example": "Cinematic Glow Pro" },
    "version": { "type": "string", "example": "1.2.0" },
    "category": { 
      "type": "string", 
      "enum": ["color", "blur", "stylize", "keying", "utility"] 
    },
    "engine": {
      "type": "object",
      "required": ["runtime"],
      "properties": {
        "runtime": { "type": "string", "enum": ["webgpu", "webgl2", "wasm"] },
        "entryPoint": { "type": "string", "description": "WGSL/GLSL path or bundle URL" }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "default"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": { 
            "type": "string", 
            "enum": ["float", "int", "boolean", "color", "vec2", "vec3f", "vec4f", "select", "texture"] 
          },
          "default": { "type": ["number", "boolean", "string", "array"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "keyframable": { "type": "boolean", "default": true },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": ["string", "number"] }
              }
            }
          }
        }
      }
    }
  }
}
