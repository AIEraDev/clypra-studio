{
  "name": "@clypra-studio/runtime",
  "version": "0.2.1",
  "license": "MIT",
  "keywords": [
    "clypra",
    "clypra-studio",
    "runtime",
    "video-effects-runtime",
    "render-planner",
    "open-source"
  ],
  "description": "Shared runtime infrastructure for all Clypra Studio Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./graph": "./dist/graph/index.js",
    "./project": "./dist/project/index.js",
    "./compiler": "./dist/compiler/index.js",
    "./planner": "./dist/planner/index.js",
    "./job": "./dist/job/index.js",
    "./executor": "./dist/executor/index.js",
    "./state": "./dist/state/index.js",
    "./pixi": "./dist/pixi/index.js",
    "./null": "./dist/null/index.js",
    "./resources": "./dist/resources/index.js",
    "./validation": "./dist/validation/index.js",
    "./telemetry": "./dist/telemetry/index.js",
    "./webgpu": "./dist/webgpu/index.js",
    "./bridge": "./dist/bridge/index.js",
    "./keyframe": "./dist/keyframe/index.js",
    "./nodes": "./dist/nodes/index.js",
    "./audio": "./dist/audio/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "playwright test",
    "test:gpu:ui": "playwright test --ui",
    "test:serve": "vite serve src/__tests__/gpu --port 5173",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clypra-studio/types": "workspace:^",
    "pixi-filters": "^6.0.4",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@webgpu/types": "^0.1.71",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "tsup": "^8.3.5",
    "typescript": "~5.8.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIEraDev/clypra-studio.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/AIEraDev/clypra-studio/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/AIEraDev/clypra-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
