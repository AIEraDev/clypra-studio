{
  "name": "@clypra-studio/shaders",
  "version": "0.1.5",
  "license": "MIT",
  "keywords": [
    "clypra",
    "clypra-studio",
    "shaders",
    "glsl",
    "webgl",
    "webgpu",
    "video-effects",
    "open-source"
  ],
  "description": "Reusable GLSL shader library for video effects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./noise": {
      "types": "./dist/noise/index.d.ts",
      "import": "./dist/noise/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIEraDev/clypra-studio.git",
    "directory": "packages/shaders"
  },
  "homepage": "https://github.com/AIEraDev/clypra-studio/tree/main/packages/shaders#readme",
  "bugs": {
    "url": "https://github.com/AIEraDev/clypra-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
