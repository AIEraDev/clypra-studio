{
  "name": "@clypra/video-renderer",
  "version": "0.1.0",
  "description": "Professional PixiJS-based video rendering engine for Clypra Editor and Studio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./layers": {
      "import": "./dist/layers/index.js",
      "types": "./dist/layers/index.d.ts"
    },
    "./transitions": {
      "import": "./dist/transitions/index.js",
      "types": "./dist/transitions/index.d.ts"
    },
    "./filters": {
      "import": "./dist/filters/index.js",
      "types": "./dist/filters/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0",
    "pixi-filters": "^6.0.0"
  },
  "dependencies": {
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
