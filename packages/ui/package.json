{
  "name": "@clypra/ui",
  "version": "1.0.0",
  "description": "Shared UI components for all Clypra Studio Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./components/*": "./dist/components/*/index.js"
  },
  "scripts": {
