{
  "name": "@clypra-studio/ui",
  "version": "0.3.0",
  "license": "MIT",
  "keywords": [
    "clypra",
    "clypra-studio",
    "ui-components",
    "react",
    "video-editor-ui",
    "open-source"
  ],
  "description": "Shared UI components for all Clypra Studio Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./components/*": "./dist/components/*/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clypra-studio/types": "workspace:^0.5.0",
    "@clypra-studio/runtime": "workspace:^0.2.2",
    "@clypra-studio/engine": "workspace:^1.3.0",
    "@clypra/ui-color-picker": "workspace:^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.14.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "~5.8.2",
    "tsup": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIEraDev/clypra-studio.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/AIEraDev/clypra-studio/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/AIEraDev/clypra-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
